# Traceability banner shown in Swagger UI / HTML responses.
ENVIRONMENT=local

# Local development uses the discrete DATABASE_* parts below (the test suite
# also needs them, to create/target a per-run database).
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=ember
DATABASE_ECHO=false

# Production (docker-compose / Coolify) passes full URLs instead; when set,
# these take precedence over the discrete parts above.
#   DATABASE_URL         runtime (pooled) connection
#   DATABASE_DIRECT_URL  direct (non-pooled) connection, used for migrations
# DATABASE_URL=
# DATABASE_DIRECT_URL=

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
INVITE_CODE_TTL_DAYS=7

# Leave enabled to create the initial account. Set to false afterward to close
# both the signup page and the registration API.
SIGNUP_ENABLED=true

# Mail module (docs/rfc/mail-module.md). Off by default; no mail server needed
# to run Ember. When enabled, point at the mail server's management API.
MAIL_ENABLED=false
# MAIL_SERVER_URL=https://mail.example.com
# MAIL_ADMIN_TOKEN=
# MAIL_HTTP_TIMEOUT_SECONDS=10

# Outbound delivery. MX/receiving can remain on Stalwart when this is resend.
MAIL_OUTBOUND_PROVIDER=stalwart
# RESEND_API_KEY=re_...
# RESEND_TIMEOUT_SECONDS=10

# Optional: when set, new mail domains get a Stalwart Domain with automatic
# DNS management pointed at this Cloudflare account — MX/SPF/DKIM/DMARC get
# published (and kept in sync) without touching the Cloudflare dashboard.
# Needs a scoped API token (Zone:DNS:Edit, Zone:Zone:Read) for the zone(s)
# domains will be added under; the domain must already be an active zone in
# this Cloudflare account (Ember does not create zones or change registrar
# nameservers).
# CLOUDFLARE_API_TOKEN=
CALENDARIFIC_API_KEY=
HOLIDAY_HTTP_TIMEOUT_SECONDS=15

# Personal Space vision-board uploads. Keep this server-side only.
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
CLOUDINARY_URL=

# GitHub integration (docs/rfc/github-integration.md). Off by default — Ember
# runs fine without it. When all three of CLIENT_ID, CLIENT_SECRET and
# TOKEN_ENCRYPTION_KEY are set, "Connect GitHub" appears in Settings and each
# workspace gets a GitHub view listing issues from the repositories it tracks.
#
# Register an OAuth App at https://github.com/settings/developers with the
# Authorization callback URL set to:
#   <PUBLIC_APP_URL>/api/integrations/github/callback
# The requested scopes are `repo read:org` — `repo` because GitHub has no
# issues-only scope for OAuth Apps, `read:org` so organization repositories
# appear in the picker alongside personal ones.
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=

# Encrypts GitHub tokens at rest. Unlike passwords (hashed), an access token
# has to be replayed to GitHub, so it is encrypted instead. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotating this key invalidates every stored token; affected users reconnect.
# GITHUB_TOKEN_ENCRYPTION_KEY=

# Override only for GitHub Enterprise Server.
# GITHUB_API_URL=https://api.github.com
# GITHUB_OAUTH_BASE_URL=https://github.com
# GITHUB_HTTP_TIMEOUT_SECONDS=15

# Public origin of the web app. The OAuth callback is a browser redirect, so it
# needs an absolute URL to send the user back to.
PUBLIC_APP_URL=http://localhost:6000

# Sentry error/performance/log monitoring. Off by default — Ember runs fine
# without it. When set, sentry_sdk.init() runs at import time in main.py.
# SENTRY_DSN=https://...@....ingest.us.sentry.io/...
SENTRY_TRACES_SAMPLE_RATE=1.0
